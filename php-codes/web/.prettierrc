{
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "printWidth": 150,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": ["@prettier/plugin-php"],
    "phpVersion": "8.0",
    "braceStyle": "psr-2",
    "overrides": [
        {
            "files": "*.php",
            "options": {
                "parser": "php",
                "tabWidth": 4,
                "printWidth": 150
            }
        }
    ]
}
