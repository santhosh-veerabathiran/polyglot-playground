{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/user/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/user/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/user",
  "projects": {
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    },
    "typesense": {
      "type": "application",
      "root": "apps/typesense",
      "entryFile": "main",
      "sourceRoot": "apps/typesense/src",
      "compilerOptions": {
        "tsConfigPath": "apps/typesense/tsconfig.app.json"
      }
    },
    "typeorm": {
      "type": "application",
      "root": "apps/typeorm",
      "entryFile": "main",
      "sourceRoot": "apps/typeorm/src",
      "compilerOptions": {
        "tsConfigPath": "apps/typeorm/tsconfig.app.json"
      }
    },
    "database": {
      "type": "application",
      "root": "apps/database",
      "entryFile": "main",
      "sourceRoot": "apps/database/src",
      "compilerOptions": {
        "tsConfigPath": "apps/database/tsconfig.app.json"
      }
    },
    "fastify-app": {
      "type": "application",
      "root": "apps/fastify-app",
      "entryFile": "main",
      "sourceRoot": "apps/fastify-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/fastify-app/tsconfig.app.json"
      }
    }
  }
}